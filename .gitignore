# No trailing slash: scratch worktrees symlink node_modules rather than
# installing it, and a trailing slash would only match a real directory.
node_modules
dist/
# Declaration files belong in dist/ (see tsconfig.build.json). Any *.d.ts under
# src/ is an accidental tsc emit — ignore so it can never be committed again.
src/**/*.d.ts
src/**/*.d.ts.map
*.tsbuildinfo
.claude/worktrees/
docs/.vitepress/cache/
coverage/
.doc-verify/

# Reference worktrees materialised by `pnpm perf:guard:grammars`.
.cache/
